 "mitreGroupId": "G0007",
 "identification": {
  "summary": "Russian military intelligence (GRU Unit 26165) cyber actor focused on strategic intelligence targets [S1]. Since 2022 it has focused on Ukraine's war effort and on Western logistics and technology companies that coordinate and deliver aid to Ukraine, including compromising IP cameras at border crossings to track shipments [S2]. It uses custom tools such as GooseEgg alongside public exploits [S1].",
  "firstObserved": "MITRE: active since at least 2004 [S3]. GooseEgg in use since at least June 2020, possibly April 2019 [S1].",
  "notes": "Microsoft name: Forest Blizzard (formerly STRONTIUM). Microsoft maps FANCY BEAR, APT28, Sofacy, Sednit and others to it [S5]; MITRE tracks it as APT28 (G0007) [S3]. Nineteen APT29 names that the source merge had placed on this record (e.g. Cozy Bear, NOBELIUM, Dark Halo) were moved to Midnight Blizzard."
 },
 "attribution": {
  "sponsor": "Russian Federation: GRU 85th Main Special Service Center (GTsSS), military Unit 26165 [S1][S2].",
  "confidence": "US and UK governments attribute the actor to GRU Unit 26165 [S1]. A multinational joint advisory (21 May 2025) attributes the logistics-targeting campaign to Unit 26165 [S2].",
  "basis": "Government attribution and joint advisory [S2]; Microsoft telemetry and malware analysis [S1]."
 },
 "objectives": "Strategic intelligence for the Russian military and state. Since 2022, collection on Ukraine and on the Western logistics and technology firms that move aid to Ukraine, including tracking shipments through compromised cameras, which agencies assess could enable sabotage or kinetic targeting [S2].",
 "targeting": {
  "sectors": [
   "Government and non-governmental organizations",
   "Defense",
   "Transportation and logistics",
   "Information technology",
   "Education",
   "IP cameras at Ukrainian border crossings and in Ukraine and bordering NATO states"
  ],
  "regions": [
   "Ukraine",
   "NATO member states, Western Europe and North America"
  ],
  "notes": "Sector targeting from Microsoft [S1] and the 2025 joint advisory as summarized by the German BfV and coverage [S2][S4]."
 },
 "capabilities": {
  "summary": "Credential theft and privilege escalation with GooseEgg, which exploits Windows Print Spooler CVE-2022-38028 [S1]. Public exploits, including CVE-2023-23397 [S1]. In the 2025 campaign: password spraying, spear-phishing and modification of Exchange mailbox permissions to maintain access [S2][S4]. Compromise of internet-connected IP cameras for surveillance [S2]. MITRE lists 93 techniques and 29 software entries, including X-Agent (CHOPSTICK), Zebrocy, LoJax, Drovorub and LAMEHUG [S3].",
