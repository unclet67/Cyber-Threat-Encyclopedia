 "relatedMs": [],
 "mitreGroupId": "G0016",
 "identification": {
  "summary": "Russian foreign intelligence (SVR) cyber-espionage actor that conducts long-term, patient intrusions against governments, diplomatic entities, NGOs and IT service providers, mainly in the US and Europe [S1]. Responsible for the SolarWinds supply-chain compromise (attributed 2021) [S3] and the 2023–2024 breach of Microsoft's corporate email [S1]. Known for identity- and cloud-focused tradecraft: password spraying, OAuth application abuse and residential proxy networks [S1].",
  "firstObserved": "MITRE: operating since at least 2008 [S4].",
  "notes": "Microsoft name: Midnight Blizzard (formerly NOBELIUM). Microsoft maps COZY BEAR, UNC2452 and APT29 to it [S6]; MITRE tracks it as APT29 (G0016) [S4]. CERT-UA tracks overlapping 2024 activity as UAC-0215 [S2]."
 },
 "attribution": {
  "sponsor": "Russian Federation: Foreign Intelligence Service (SVR) [S1][S3].",
  "confidence": "The US Intelligence Community assessed attribution of SolarWinds to the SVR with HIGH confidence (White House, 15 Apr 2021); the UK NCSC judged it 'highly likely' [S3]. Microsoft cites US and UK government attribution to the SVR [S1][S2].",
  "basis": "US and UK government attribution with joint NSA/CISA/FBI advisory [S3]; Microsoft incident response on its own corporate environment [S1]; Microsoft telemetry [S2]."
 },
 "objectives": "Strategic intelligence collection through long-standing, dedicated espionage [S1], focused on foreign policy, government decision-making, diplomacy and the technology supply chain. Access to IT and cloud service providers gives a route into many downstream customers, as SolarWinds showed [S3].",
 "targeting": {
  "sectors": [
   "Government and diplomatic entities",
   "Non-governmental organizations and think tanks",
   "IT service providers and cloud/technology companies (including Microsoft)",
   "Higher education",
   "Defense"
  ],
  "regions": [
   "United States",
   "Europe, including the United Kingdom",
   "Australia and Japan (Oct 2024 RDP campaign)"
  ],
  "notes": "Sectors and regions from Microsoft [S1][S2]."
 },
 "capabilities": {
  "summary": "Identity and cloud tradecraft: password spraying from residential proxies against accounts without MFA, abuse of legacy OAuth applications to grant itself mailbox access (full_access_as_app) through Exchange Web Services [S1]. Large-scale spear-phishing with signed RDP configuration files that map local resources to actor-controlled servers (Oct 2024, thousands of targets in over 100 organizations) [S2]. Supply-chain compromise (SolarWinds Orion) [S3]. MITRE lists 66 techniques and 49 software entries, including the 'Duke' malware families, WellMess and Cobalt Strike [S4].",
