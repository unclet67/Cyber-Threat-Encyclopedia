 "identification": {
  "summary": "China-based actor that combines state-sponsored espionage with financially motivated intrusions. US charges describe members working through a Chengdu company and compromising more than 100 victims worldwide, stealing source code, code-signing certificates, customer data and business information [S1]. Mandiant documented a deliberate 2021–2022 campaign that compromised at least six US state government networks [S2]. Google disrupted a 2025 campaign that used Google Calendar for command and control [S3].",
  "firstObserved": "MITRE: active since at least 2012 [S4]. US indictments were returned in August 2019 and August 2020 [S1].",
  "notes": "Microsoft name: Brass Typhoon (formerly BARIUM). Microsoft maps WICKED PANDA and APT41 to it [S5]. Microsoft tracks Leopard Typhoon (LEAD / Winnti Group) separately, though both share the CrowdStrike label WICKED PANDA; public 'Winnti' reporting often blurs the two."
 },
 "attribution": {
  "sponsor": "People's Republic of China. Indicted members include employees of Chengdu 404 Network Technology [S1].",
  "confidence": "Formal US charges against five PRC nationals (announced 16 Sep 2020) [S1]. Mandiant describes APT41 as state-sponsored with a history of moonlighting for personal financial gain [S2].",
  "basis": "DOJ indictments and domain/server seizures [S1]; Mandiant incident response [S2]; Google Threat Intelligence [S3]."
 },
 "objectives": "Dual-purpose: espionage aligned with PRC state priorities and theft for profit. Mandiant could not determine the motive of the state-government campaign, given the group's history of financially motivated activity [S2]. Theft of source code and code-signing certificates enables later supply-chain operations [S1].",
 "targeting": {
  "sectors": [
   "Software and video-game companies (source code, signing certificates)",
   "Telecommunications",
   "US state governments",
   "Government entities (2025 TOUGHPROGRESS campaign)",
   "Healthcare, higher education and technology (broad victim set in indictment)"
  ],
  "regions": [
   "United States",
   "Global: more than 100 victims across multiple countries"
  ],
  "notes": "Victims from the 2020 indictment coverage [S1], Mandiant [S2] and GTIG [S3]."
 },
 "capabilities": {
  "summary": "Exploitation of internet-facing web applications, including .NET deserialization, SQL injection, directory traversal and a zero-day in the USAHerds livestock-tracking application (CVE-2021-44207) [S2]. Supply-chain compromise using stolen code-signing certificates [S1]. Abuse of cloud services for C2: TOUGHPROGRESS used hidden Google Calendar events for commands and exfiltration [S3]. MITRE lists 82 techniques and 32 software entries, including ShadowPad, Winnti for Linux, KEYPLUG, DUSTPAN, DUSTTRAP and MESSAGETAP [S4].",
