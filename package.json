{
  "name": "cyber-threat-encyclopedia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/build-client.mjs && node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p '*_test.py'",
    "enrichment:sync": "node scripts/sync-galaxy.mjs",
    "monitor": "python3 scripts/monitor-watchlist.py"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261015.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.37",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "5.9.3",
    "vinext": "1.2.0",
    "vite": "8.3.4",
    "wrangler": "4.151.0"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
